# Disposable Linux/WSL local evaluation only. Never deploy this file.
# Replace the complete URL and absolute directory before running migrations.
ENVIRONMENT=test
DATABASE_URL=postgresql+asyncpg://virexa_local:REPLACE_URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:5432/virexa_python_local
ALLOWED_ORIGINS=http://127.0.0.1:3000
PUBLIC_API_ORIGIN=http://127.0.0.1:3000
DOCUMENT_STORAGE_ROOT=/REPLACE_WITH_PRIVATE_ABSOLUTE_PATH/quarantine
ALLOW_LEGACY_REGISTRATION=false
SIGNUP_EMAIL_DELIVERY=local_smtp
SIGNUP_SMTP_PORT=1025
